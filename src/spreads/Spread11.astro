---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import BlockPrint from "~/components/BlockPrint.astro"

/*
 * Spread 11 — the next one. Mostly blank ruled page, on purpose. The "close
 * the notebook" control (chrome) appears over it once the read completes.
 * Back on white stock.
 */
---

<section class="tc-sector is-ruled" id="tc-sector-11" aria-label="Page 11: Next Wednesday">
    <p class="spread-head t-eyebrow">
        <span>p. 11</span>
        <span class="rule" aria-hidden="true"></span>
        <span>wednesday no. 13</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Next <em>Wednesday</em></h2>

    <p class="spread-note t-body">
        There's a list already. A lamp, still. The chair came back up. Someone
        wants to make the pencil we keep losing. The notebook goes with
        whoever takes it home.
    </p>

    <Note x={130} y={400} w={300} rotate={-2} size="lg" tone="red">
        bring the pencil idea
    </Note>

    <Note x={150} y={470} rotate={-1} size="sm">— and the good lamp</Note>

    <Clipping
        id="11-0"
        src="nextweek"
        caption="7pm. kettle's on."
        x={900}
        y={330}
        w={340}
        h={240}
        kind="scrap"
        rotate={-2}
    />

    <Note x={560} y={620} rotate={-3} tone="blue" arrow="right">continue</Note>

    <BlockPrint motif="star" x={700} y={400} w={70} rotate={20} ink="yellow" />
</section>
