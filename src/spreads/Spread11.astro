---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"

/* Spread 11 — the second and third. The yellow sheet. */
---

<section class="tc-sector" id="tc-sector-11" aria-label="Page 11: Again, but slower">
    <p class="spread-head t-eyebrow">
        <span>wednesdays no. 10 – 11</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Again, but <em>slower</em></h2>

    <p class="spread-note t-body">
        Second one: grain the right way, staples measured twice. Third one:
        we stopped talking while printing. That was the difference.
    </p>

    <Clipping
        id="11-0"
        src="ribbon"
        caption="no. 2 — opens flat ✓"
        x={120}
        y={330}
        w={270}
        h={370}
        kind="scan"
        rotate={-3}
    />

    <Clipping
        id="11-1"
        src="stack"
        caption="one, two, three"
        x={500}
        y={400}
        w={400}
        h={260}
        kind="scan"
    />

    <Note x={960} y={420} w={260} rotate={-3} size="lg" tone="ink" arrow="left">
        no. 3 — the quiet one
    </Note>
</section>
