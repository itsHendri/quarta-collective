---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import Sticker from "~/components/Sticker.astro"

/* Spread 01 — the rule. */
---

<section class="tc-sector is-ruled" id="tc-sector-01" aria-label="Page 1: One evening a week">
    <p class="spread-head t-eyebrow">
        <span>p. 01</span>
        <span class="rule" aria-hidden="true"></span>
        <span>wednesday no. 1</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>One evening a <em>week</em></h2>

    <p class="spread-note t-body">
        Same table, same night. Phones in a bowl by the door. Whoever arrives
        first puts the kettle on; whoever arrives last does the dishes. Nobody
        has to bring anything finished — just something started.
    </p>

    <Sticker x={1060} y={104} rotate={-8}>est. autumn 2026</Sticker>

    <Clipping
        id="01-0"
        src="artclass"
        caption="wk 1 — nobody knew what to make yet"
        x={760}
        y={330}
        w={430}
        h={290}
        kind="photo"
        tape
        eager
    />

    <Clipping
        id="01-1"
        src="table"
        caption="the table, before"
        x={150}
        y={430}
        w={320}
        h={210}
        kind="scrap"
        rotate={-2}
        eager
    />

    <Note x={500} y={430} w={210} rotate={-4} arrow="right">
        the rule: show up, bring something half-finished
    </Note>
</section>
