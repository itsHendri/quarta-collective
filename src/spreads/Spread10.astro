---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import PixelMark from "~/components/PixelMark.astro"

/* Spread 10 — printing. The block and its two passes, printed on the page. */
---

<section class="tc-sector is-ruled" id="tc-sector-10" aria-label="Page 10: Printing">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 9</span>
    </p>

    <h2 class="spread-title t-display" data-reveal><em>Printing</em></h2>

    <p class="spread-note t-body">
        Lino, because a block should look like hands cut it. Pressure is the
        whole thing: too light and the ink sits in flecks, too hard and the
        paper goes shiny and the edges fill in.
    </p>

    <Clipping
        id="10-0"
        src="papers"
        caption="test pulls, in order"
        x={90}
        y={350}
        w={450}
        h={290}
        kind="photo"
    />

    {/* The block itself, printed twice: the second pass lands 4px off. */}
    <PixelMark motif="scissors" x={610} y={390} w={130} rotate={-6} ink="blue" pass2="red" />
    <PixelMark motif="staple" x={800} y={450} w={110} rotate={8} ink="green" />
    <Note x={600} y={590} rotate={-2} size="sm" tone="blue">second pass, 4mm out — keep</Note>

    <Clipping
        id="10-1"
        src="thread"
        caption="brayer, ink, two sheets of scrap"
        x={960}
        y={310}
        w={320}
        h={320}
        kind="polaroid"
        rotate={3}
    />
</section>
