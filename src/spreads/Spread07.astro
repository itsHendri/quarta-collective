---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import Sticker from "~/components/Sticker.astro"

/* Spread 07 — materials. The stock is turning to newsprint here. */
---

<section class="tc-sector" id="tc-sector-07" aria-label="Page 7: Paper, ink, blade">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 6</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Paper, ink, <em>blade</em></h2>

    <p class="spread-note t-body">
        Samples from three shops and a skip. Paper is judged by folding it,
        ink by how it sits on the fold, the lino by how it takes a blade.
    </p>

    <Sticker x={1150} y={88} rotate={6} kind="tag">samples</Sticker>

    <Clipping
        id="07-0"
        src="creased"
        caption="120gsm — too thin"
        x={80}
        y={350}
        w={300}
        h={220}
        kind="scan"
        rotate={-3}
    />

    <Clipping
        id="07-1"
        src="spools"
        caption="riso blue, two passes"
        x={430}
        y={390}
        w={320}
        h={230}
        kind="scan"
        rotate={2}
    />

    <Clipping
        id="07-2"
        src="sheets"
        caption="160 — just right"
        x={800}
        y={320}
        w={440}
        h={290}
        kind="scan"
        rotate={-1}
    />

    <Note x={90} y={620} rotate={-2} size="sm">grey lino, 3mm, from the skip</Note>
</section>
