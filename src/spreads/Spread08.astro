---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import Sticker from "~/components/Sticker.astro"

/* Spread 08 — the first lamp. Newsprint turning to the yellow sheet. */
---

<section class="tc-sector is-grid" id="tc-sector-08" aria-label="Page 8: Prototype one">
    <p class="spread-head t-eyebrow">
        <span>p. 08</span>
        <span class="rule" aria-hidden="true"></span>
        <span>wednesday no. 8</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Prototype <em>one</em></h2>

    <p class="spread-note t-body">
        Wired in forty minutes. The shade held. The base didn't: the first
        time we stood it up it leaned, and then it kept leaning.
    </p>

    <Clipping
        id="08-0"
        src="wiring"
        caption="live, briefly"
        x={760}
        y={340}
        w={460}
        h={300}
        kind="photo"
        tape
    />

    <Clipping
        id="08-1"
        src="offcuts"
        caption="no. 1, and what it was cut from"
        x={160}
        y={420}
        w={300}
        h={210}
        kind="scrap"
        rotate={4}
    />

    <Note x={500} y={330} w={220} rotate={-6} size="lg" tone="red" arrow="right">
        grain direction!! (wrong way)
    </Note>

    <Note x={170} y={340} rotate={-2} size="sm">
        base <s>90 × 90</s> 120 × 120
    </Note>

    <Sticker x={1020} y={680} rotate={-8} tone="blue">failed — keep</Sticker>
</section>
