---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"

/* Spread 08 — the bench. Full newsprint. */
---

<section class="tc-sector is-squared" id="tc-sector-08" aria-label="Page 8: The bench">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 7</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>The <em>bench</em></h2>

    <p class="spread-note t-body">
        Three lamps, one good one. The table has a dent from the night the
        press slipped. Nobody fixes it; it's where the ruler lives now.
    </p>

    <div class="ring" style="left: 1120px; top: 110px;" aria-hidden="true"></div>
    <Note x={1240} y={160} rotate={4} size="sm" arrow="left">wk 7</Note>

    <Clipping
        id="08-0"
        src="tools"
        caption="everything, once, in its place"
        x={90}
        y={480}
        w={420}
        h={270}
        kind="scan"
    />

    <Clipping
        id="08-1"
        src="benchtop"
        caption="everything, by nine"
        x={560}
        y={470}
        w={320}
        h={220}
        kind="scan"
        rotate={-3}
    />

    <Clipping
        id="08-2"
        src="papers"
        caption="the good lamp"
        x={940}
        y={320}
        w={340}
        h={250}
        kind="scan"
        rotate={2}
    />
</section>
