---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import Sticker from "~/components/Sticker.astro"

/*
 * Spread 06 — the argument. The red note is size="lg": display-size red is
 * the only red that carries words (Q8).
 */
---

<section class="tc-sector is-ruled" id="tc-sector-06" aria-label="Page 6: What are we actually making?">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 5</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>What are we actually <em>making?</em></h2>

    <p class="spread-note t-body">
        The argument lasted most of an evening. A lamp. A chair. An app, briefly.
        Then someone said: the thing we keep reaching for, every week, is a
        notebook. So make one. Half of it printed — ours. Half of it blank —
        whoever holds it.
    </p>

    <Clipping
        id="06-0"
        src="mug"
        caption="the evening in question"
        x={820}
        y={340}
        w={440}
        h={290}
        kind="scan"
        tape
    />

    <Note x={130} y={380} w={380} rotate={-2} size="lg">
        lamp ✗ &nbsp; chair ✗ &nbsp; app ✗✗
    </Note>

    <Sticker x={330} y={470} rotate={-10} tone="red">parked</Sticker>

    <Note x={470} y={580} w={260} rotate={-3} size="lg" tone="red" arrow="right">
        a notebook. obviously.
    </Note>
</section>
