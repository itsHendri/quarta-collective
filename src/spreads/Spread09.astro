---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import Sticker from "~/components/Sticker.astro"

/* Spread 09 — the first one. Newsprint turning to the yellow sheet. */
---

<section class="tc-sector is-grid" id="tc-sector-09" aria-label="Page 9: Prototype one">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 8</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Prototype <em>one</em></h2>

    <p class="spread-note t-body">
        Eight pages from one sheet, folded, stapled twice, printed in forty
        minutes. The fold was fine. The staples went through the wrong page.
    </p>

    <Clipping
        id="09-0"
        src="pages"
        caption="folded, then stapled wrong"
        x={760}
        y={340}
        w={460}
        h={300}
        kind="scan"
        tape
    />

    <Clipping
        id="09-1"
        src="spine"
        caption="no. 1"
        x={160}
        y={490}
        w={300}
        h={210}
        kind="scan"
        rotate={4}
    />

    <Note x={520} y={480} w={220} rotate={-6} size="lg" tone="red" arrow="right">
        grain direction!! (wrong way)
    </Note>

    <Note x={540} y={360} rotate={-2} size="sm">
        cut <s>148 × 210</s> 140 × 205
    </Note>

    <Sticker x={1020} y={680} rotate={-8} tone="red">failed — keep</Sticker>
</section>
