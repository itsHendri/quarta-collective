---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import SketchMark from "~/components/SketchMark.astro"
import { CREDITS } from "~/content/clippings"

/*
 * Spread 00 — the cover.
 *
 * The only spread with the fold and staples, and the only out-of-fiction
 * surface in the piece (the colophon). Both live here because nothing may come after
 * the scroll track (memory-lane #36).
 *
 * "Quarta" — quarta-feira, Wednesday. The evening we meet.
 */
---

<section class="tc-sector" id="tc-sector-00" aria-label="Cover: Quarta Collective">
    <div class="binding" aria-hidden="true"></div>

    <p class="spread-head t-eyebrow">
        <span>Quarta Collective</span>
        <span class="rule" aria-hidden="true"></span>
        <span>issue no. 1</span>
    </p>

    <h1 class="spread-title t-display" data-reveal>The art of <em>making</em></h1>

    <p class="spread-note t-body">
        A space to make and create with friends. Four of us, one table,
        Wednesday evenings. This is the story of how a thing gets made here —
        this season, a notebook, by hand: half printed, half blank.
    </p>

    <Clipping
        id="00-0"
        src="cover"
        caption="the one we're making"
        x={960}
        y={110}
        w={280}
        h={380}
        kind="scan"
        rotate={3}
        eager
    />

    <Note x={740} y={560} rotate={-4} size="lg">open me</Note>
    <SketchMark motif="arrow" x={870} y={560} w={72} ink="ink" />

    <SketchMark motif="asterisk" x={580} y={380} w={64} rotate={-8} ink="red" weight={3} />

    <div class="colophon t-eyebrow">
        <p>
            Quarta Collective is a space to make and create with friends —
            Hendri and a few others, once a week. This site tells the story;
            the notebook itself is made by hand. Placeholder photographs from Unsplash
            by {CREDITS.map((c) => `@${c}`).join(", ")}. Type: Special Elite ·
            Caveat · Courier Prime. hendri.design · 2026.
        </p>
    </div>
</section>
