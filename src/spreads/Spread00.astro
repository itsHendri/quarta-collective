---
import Clipping from "~/components/Clipping.astro"
import People from "~/components/People.astro"

/*
 * Spread 00 — the cover.
 *
 * The fold and staples are gone: on the pile the cover is a loose sheet,
 * and the binding read as a clipboard (Q23). So is the red asterisk. The
 * colophon moved to the back cover (Q21).
 *
 * "Quarta" — quarta-feira, Wednesday. The evening we meet.
 */
---

<section class="tc-sector" id="tc-sector-00" aria-label="Cover: Quarta Collective">

    <h1 class="spread-title t-display" data-reveal>The art of <em>making</em></h1>

    <p class="spread-note t-body">
        A space to make and create with friends. Three of us, one table,
        Wednesday evenings. This is the story of how a thing gets made here —
        this season, a notebook, by hand: half printed, half blank.
    </p>

    <People />

    <Clipping
        id="00-0"
        src="cover"
        caption="the one we're making"
        x={960}
        y={110}
        w={280}
        h={380}
        kind="scan"
        rotate={3}
        eager
    />

</section>
