---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"
import SketchMark from "~/components/SketchMark.astro"

/* Spread 04 — sketches. The warm-white stretch of the stock. */
---

<section class="tc-sector" id="tc-sector-04" aria-label="Page 4: Bad drawings first">
    <p class="spread-head t-eyebrow">
        <span>wednesday no. 3</span>
    </p>

    <h2 class="spread-title t-display" data-reveal>Bad drawings <em>first</em></h2>

    <p class="spread-note t-body">
        The first twenty sketches are for getting the bad ones out. Nobody is
        allowed to erase. The point is the pile, not the page.
    </p>

    <Clipping
        id="04-0"
        src="pillows"
        caption="twenty of these. then one more."
        x={90}
        y={360}
        w={430}
        h={290}
        kind="scan"
    />

    <Clipping
        id="04-1"
        src="portrait"
        caption="no. 14"
        x={580}
        y={400}
        w={210}
        h={270}
        kind="scan"
        rotate={3}
    />

    <Clipping
        id="04-2"
        src="desk"
        caption="J., not erasing"
        x={880}
        y={330}
        w={380}
        h={250}
        kind="scan"
        rotate={-2}
    />

    <Note x={560} y={300} w={200} rotate={-4} arrow="down">
        the only good one
    </Note>

    <Note x={1000} y={660} rotate={-2}><s>final</s> first draft</Note>

    <SketchMark motif="ring" x={1170} y={120} w={110} rotate={-8} ink="red" />
</section>
