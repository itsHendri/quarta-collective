---
import Plate from "~/components/Plate.astro"
import fdo from "~/assets/plates/fdo.jpg"
import pcb from "~/assets/plates/pcb.jpg"

/*
 * Sector 09 — "Held signal".
 *
 * Escalation of 08. The keeper kept copies of what mattered; so does the rig.
 */
---

<section class="tc-sector" id="tc-sector-09" aria-label="Sector 09: Held signal">
    <p class="sector-head t-eyebrow">
        <span>sector 09</span>
        <span class="rule" aria-hidden="true"></span>
        <span>2 frames</span>
    </p>

    <h2 class="sector-title t-display" data-scramble>Held signal</h2>

    <p class="sector-note t-body">the same frames, filed twice. both copies retained.</p>

    <Plate
        id="09-0"
        src={pcb}
        label="duplicate of 01·00"
        alt="board, component side"
        fmt="RAW"
        file="pcb"
        x={84}
        y={318}
        w={300}
        h={320}
    />

    <Plate
        id="09-1"
        src={fdo}
        label="duplicate of 02·00"
        alt="console wall, lit"
        fmt="JPG"
        file="fdo"
        x={434}
        y={362}
        w={400}
        h={260}
    />
</section>
