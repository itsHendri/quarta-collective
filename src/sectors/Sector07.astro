---
import Plate from "~/components/Plate.astro"
import compute from "~/assets/plates/compute.jpg"
import mercury from "~/assets/plates/mercury.jpg"

/*
 * Sector 07 — "Head down".
 *
 * The quiet centre. The read head is down; so is she.
 *
 * "Working", not "mid-calculation": the photograph shows her standing at the
 * machine, and the machine only claims what it can see.
 */
---

<section class="tc-sector" id="tc-sector-07" aria-label="Sector 07: Head down">
    <p class="sector-head t-eyebrow">
        <span>sector 07</span>
        <span class="rule" aria-hidden="true"></span>
        <span>2 frames</span>
    </p>

    <h2 class="sector-title t-display" data-scramble>Head down</h2>

    <p class="sector-note t-body">one operator, working. the panel she faced is filed next to her.</p>

    <Plate
        id="07-0"
        src={compute}
        label="operator, working"
        fmt="TIF"
        file="compute"
        x={72}
        y={344}
        w={430}
        h={280}
    />

    <Plate
        id="07-1"
        src={mercury}
        label="panel, close range"
        fmt="TIF"
        file="mercury"
        x={560}
        y={366}
        w={380}
        h={250}
    />
</section>
