---
import Plate from "~/components/Plate.astro"
import manometer from "~/assets/plates/manometer.jpg"
import tunnel from "~/assets/plates/tunnel.jpg"

/*
 * Sector 04 — "CRC fail".
 *
 * The corrupted sector, and the ONE place the treatment is allowed to
 * invade the read head: these plates stay half-broken even in the clean centre
 * band, on a ~7Hz block stutter that never resolves. They also never hand their
 * picture back on hover — the head retries and fails; it does not succeed
 * because a visitor insisted. (Upstream #42.)
 */
---

<section class="tc-sector" id="tc-sector-04" aria-label="Sector 04: CRC fail">
    <p class="sector-head t-eyebrow">
        <span>sector 04</span>
        <span class="rule" aria-hidden="true"></span>
        <span>2 frames</span>
    </p>

    <h2 class="sector-title t-display" data-scramble>CRC fail</h2>

    <p class="sector-note t-body">retry 3/3 · 212 bad blocks · recovered partial</p>

    <p><span class="sector-tag t-eyebrow">unreadable</span></p>

    <Plate
        id="04-0"
        src={manometer}
        label="columns, partial frame"
        fmt="RAW"
        file="manometer"
        x={66}
        y={350}
        w={400}
        h={272}
        corrupt
    />

    <Plate
        id="04-1"
        src={tunnel}
        label="instrumentation, damaged read"
        fmt="RAW"
        file="tunnel"
        x={520}
        y={382}
        w={340}
        h={238}
        corrupt
    />
</section>
