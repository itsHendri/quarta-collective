---
/*
 * Fonts first: the faces ship as @fontsource packages, so their @font-face
 * rules bundle into the single stylesheet and Vite hashes and base-prefixes
 * the files. The preloads below import the SAME files with `?url`, so the
 * href is whatever Vite emitted — no hand-built `/fonts/…` path to 404 under
 * the deploy base (memory-lane A23; DECISIONS Q3).
 *
 * Five faces, one job each (Q24): Amatic SC titles, Inter body, Courier
 * Prime labels, Special Elite captions and the page number, Caveat notes.
 */
import "@fontsource/amatic-sc/latin-700.css"
import "@fontsource/inter/latin-400.css"
import "@fontsource/special-elite/latin-400.css"
import "@fontsource-variable/caveat/index.css"
import "@fontsource/courier-prime/latin-400.css"
import "@fontsource/courier-prime/latin-700.css"
import titleUrl from "@fontsource/amatic-sc/files/amatic-sc-latin-700-normal.woff2?url"
import bodyUrl from "@fontsource/inter/files/inter-latin-400-normal.woff2?url"
import typedUrl from "@fontsource/special-elite/files/special-elite-latin-400-normal.woff2?url"
import typeUrl from "@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url"

import "~/styles/tokens.css"
import "~/styles/type.css"
import "~/styles/base.css"

interface Props {
    title?: string
    description?: string
}

const {
    title = "Quarta Collective",
    description = "A notebook of making. A few of us, one evening a week.",
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/*
 * public/ files are served verbatim under the deploy base and nothing
 * rewrites them. The favicon is now the ONLY hand-built public path.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary_large_image" />

        <meta name="theme-color" content="#f3eedd" />

        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

        {/*
          The four faces on the cover preload: the title, the body, the
          caption under the clipping and the page number, the wordmark and
          the tooltip. Caveat is not on the cover, so it does not.
          `crossorigin` is required even same-origin for fonts, or the
          preload is fetched twice.
        */}
        <link rel="preload" href={titleUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={bodyUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={typedUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={typeUrl} as="font" type="font/woff2" crossorigin />

        <slot name="head" />
    </head>
    <body>
        <slot />
    </body>
</html>
