---
/*
 * Fonts first: the three faces ship as @fontsource packages, so their
 * @font-face rules bundle into the single stylesheet and Vite hashes and
 * base-prefixes the files. The preloads below import the SAME files with
 * `?url`, so the href is whatever Vite emitted — no hand-built `/fonts/…`
 * path to 404 under the deploy base (memory-lane A23; DECISIONS Q3).
 */
import "@fontsource/instrument-serif/latin-400.css"
import "@fontsource/instrument-serif/latin-400-italic.css"
import "@fontsource-variable/caveat/index.css"
import "@fontsource/courier-prime/latin-400.css"
import "@fontsource/courier-prime/latin-700.css"
import serifUrl from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url"
import handUrl from "@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url"
import typeUrl from "@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url"

import "~/styles/tokens.css"
import "~/styles/type.css"
import "~/styles/base.css"

interface Props {
    title?: string
    description?: string
}

const {
    title = "Quarta Collective",
    description = "A notebook of making. A few of us, one evening a week.",
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/*
 * public/ files are served verbatim under the deploy base and nothing
 * rewrites them. The favicon is now the ONLY hand-built public path.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary_large_image" />

        <meta name="theme-color" content="#f4efe4" />

        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

        {/*
          All three faces paint above the fold — the headline, the caption
          under the first clipping, the eyebrow — so all three preload.
          `crossorigin` is required even same-origin for fonts, or the
          preload is fetched twice.
        */}
        <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={handUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={typeUrl} as="font" type="font/woff2" crossorigin />

        <slot name="head" />
    </head>
    <body>
        <slot />
    </body>
</html>
