---
/*
 * A notebook page: the visitor's own, between the printed spreads.
 *
 * Ruled like the rest, but blank, and WRITABLE — a contenteditable block in
 * the hand face and a drawing canvas over it, both kept in this browser's
 * localStorage by `lib/notebook.ts`. The eyebrow and the prompt are the only
 * printed things on it. The page says where the writing goes ("saved in this
 * browser only") because a notebook that quietly forgets is worse than one
 * that says it will.
 *
 * Keyboard: the text block is in the tab order; the tools are real buttons.
 */

interface Props {
    /** Spread index, for the id and the page number. */
    n: number
    /** The printed prompt at the top of the page. */
    prompt: string
    /** Stable key for storage — survives renumbering. */
    key: string
}

const { n, prompt, key } = Astro.props
const nn = String(n).padStart(2, "0")
---

<section
    class="tc-sector is-ruled notebook-spread"
    id={`tc-sector-${nn}`}
    aria-label={`Page ${n}: your page`}
>
    <p class="spread-head t-eyebrow">
        <span>p. {nn}</span>
        <span class="rule" aria-hidden="true"></span>
        <span>your page</span>
    </p>

    <p class="notebook-prompt t-hand is-lg">{prompt}</p>

    <div class="notebook" data-notebook={key}>
        <div
            class="notebook-text t-hand"
            data-nb-text
            contenteditable="plaintext-only"
            role="textbox"
            aria-multiline="true"
            aria-label="Your notes"
            data-placeholder="write here…"
            spellcheck="false"
        >
        </div>
        <canvas class="notebook-ink" data-nb-ink aria-label="Your sketch"></canvas>
    </div>

    <div class="notebook-tools" data-nb-tools>
        <button type="button" class="t-label" data-nb-mode="write" aria-pressed="true">write</button>
        <button type="button" class="t-label" data-nb-mode="draw" aria-pressed="false">draw</button>
        <button type="button" class="t-label" data-nb-clear>clear</button>
        <span class="notebook-hint t-eyebrow">saved in this browser only</span>
    </div>
</section>
