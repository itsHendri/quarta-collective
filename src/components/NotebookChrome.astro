---
interface Props {
    sectors?: number
    /** One title per spread, for the index tabs' labels. */
    titles: string[]
}
const { sectors = 12, titles } = Astro.props

/*
 * The notebook's own furniture, in three places:
 *
 *   tabs      fixed top — the index tabs along the page's top edge, one per
 *             spread. Real <button>s: the only keyboard navigation.
 *   page      fixed bottom-left — "p. 4", written in the corner.
 *   close     fixed bottom-right — "close the notebook", at the end only.
 *
 * All under the grain at z-index 10, so they are printed on the same sheet.
 * Nothing here addresses the visitor (memory-lane #15).
 */
---

<!-- ── Index tabs ─────────────────────────────────────────────────────── -->
<nav class="tabs" id="tc-rail" aria-label="Index">
    <span class="tabs-mark t-eyebrow">Quarta Collective · wednesdays</span>

    <div class="tabs-row">
        <div class="tabs-cells" data-rail-cells>
            {
                Array.from({ length: sectors }, (_, i) => (
                    <button
                        type="button"
                        class="tab"
                        data-cell={i}
                        data-state="unread"
                        aria-label={
                            i === 0 ? "Cover" : `Page ${i}: ${titles[i] ?? ""}`
                        }
                    >
                        <span class="tab-n t-value">
                            {i === 0 ? "c" : String(i).padStart(2, "0")}
                        </span>
                        <span class="tab-title t-hand is-sm" aria-hidden="true">
                            {titles[i] ?? ""}
                        </span>
                    </button>
                ))
            }
        </div>
        <i class="tabs-head" data-rail-head aria-hidden="true"></i>
    </div>
</nav>

<!-- ── Page number ────────────────────────────────────────────────────── -->
<div class="page t-hand" id="tc-page" aria-live="polite" data-page="0">
    <span data-page>cover</span>
</div>

<!-- ── Close the notebook ─────────────────────────────────────────────── -->
<button class="close t-hand" id="tc-close" type="button" hidden>
    close the notebook
    <svg viewBox="0 0 46 34" width="30" height="22" aria-hidden="true">
        <path
            d="M3 24 C 12 8, 26 6, 41 15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
        />
        <path
            d="M33 9 L 41 15 L 32 19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
</button>

<style>
    /* ── Tabs ───────────────────────────────────────────────────────── */
    .tabs {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 6;
        display: flex;
        align-items: flex-start;
        gap: 28px;
        padding: 0 24px;
        color: var(--tc-fg);
    }
    .tabs-mark {
        padding-top: 14px;
        white-space: nowrap;
    }
    .tabs-row {
        position: relative;
        flex: 1;
        min-width: 240px;
        max-width: 760px;
        margin-left: auto;
    }
    .tabs-cells {
        display: flex;
        gap: 4px;
    }

    /*
     * A tab hangs off the top edge of the page like an index tab: a small
     * paper tongue with the page number on it. Three states, drawn as a
     * notebook would show them — unread tabs are the edge of a page not yet
     * turned, the current one is pulled down, read ones are pushed up.
     */
    .tab {
        position: relative;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        border: 1px solid color-mix(in srgb, var(--tc-fg) 35%, transparent);
        border-top: none;
        border-radius: 0 0 4px 4px;
        background: color-mix(in srgb, var(--tc-field) 85%, var(--tc-fg) 0%);
        color: var(--tc-fg-dim);
        transition:
            transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1),
            background-color 220ms linear,
            color 220ms linear;
    }
    .tab-n {
        color: inherit;
    }
    .tab[data-state="read"] {
        transform: translateY(-10px);
        background: color-mix(in srgb, var(--tc-fg) 8%, var(--tc-field));
    }
    .tab[data-state="reading"] {
        transform: translateY(0);
        height: 30px;
        background: var(--tc-fg);
        color: var(--tc-field);
        border-color: var(--tc-fg);
    }
    .tab:hover,
    .tab:focus-visible {
        transform: translateY(2px);
    }

    /* The title shows on hover or focus, written under the tab. */
    .tab-title {
        position: absolute;
        top: 100%;
        left: 50%;
        margin-top: 6px;
        white-space: nowrap;
        transform: translateX(-50%) rotate(-2deg);
        color: var(--tc-fg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 160ms linear;
    }
    .tab:hover .tab-title,
    .tab:focus-visible .tab-title {
        opacity: 1;
    }

    /* A thin pencil mark gliding along the top edge: continuous progress
     * between tab boundaries (memory-lane #30). */
    .tabs-head {
        position: absolute;
        top: 0;
        left: 0;
        width: 2px;
        height: 36px;
        margin-left: -1px;
        background: var(--tc-fg);
        opacity: 0.55;
        pointer-events: none;
    }

    /* ── Page number ────────────────────────────────────────────────── */
    .page {
        position: fixed;
        left: 28px;
        bottom: 22px;
        z-index: 6;
        pointer-events: none;
        transform: rotate(-3deg);
        color: var(--tc-fg);
        opacity: 0.85;
    }

    /* ── Close ──────────────────────────────────────────────────────── */
    .close {
        position: fixed;
        right: 36px;
        bottom: 26px;
        z-index: 6;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 4px;
        color: var(--tc-fg);
        transform: rotate(-2deg);
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 4px;
        transition: opacity 240ms linear;
    }
    .close svg {
        transform: rotate(-90deg);
    }
    .close[hidden] {
        display: none;
    }

    /* The tabs are a desktop conceit: on the vertical read there is no pan
     * to index, and their seek buttons duplicate ordinary scrolling. The page
     * number and the close control survive. */
    @media (max-width: 810px) {
        .tabs-row {
            display: none;
        }
        .tabs-mark {
            padding-top: 16px;
        }
        .page {
            left: 20px;
            bottom: 16px;
        }
        .close {
            right: 20px;
            bottom: 16px;
            /* Finger-sized: the one thing on the vertical read a thumb must hit. */
            padding: 12px 8px;
        }
    }
</style>
