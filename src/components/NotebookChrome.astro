---
interface Props {
    sectors?: number
    /** One title per spread, for the index tabs' labels. */
    titles: string[]
}
const { sectors = 12, titles } = Astro.props

/*
 * The notebook's own furniture, in three places:
 *
 *   tabs      fixed top — the index tabs along the page's top edge, one per
 *             spread. Real <button>s: the only keyboard navigation.
 *   page      fixed bottom-left — "p. 4", written in the corner.
 *   close     fixed bottom-right — "close the notebook", at the end only.
 *
 * All under the grain at z-index 10, so they are printed on the same sheet.
 * Nothing here addresses the visitor (memory-lane #15).
 */
---

<!-- ── Index tabs, down the left ──────────────────────────────────────── -->
<nav class="tabs" id="tc-rail" aria-label="Index">
    <span class="tabs-mark t-eyebrow">Quarta Collective</span>
    <i class="tabs-rule" aria-hidden="true"></i>
    <div class="tabs-col">
        <div class="tabs-cells" data-rail-cells>
            {
                Array.from({ length: sectors }, (_, i) => (
                    <button
                        type="button"
                        class="tab"
                        data-cell={i}
                        data-state="unread"
                        aria-label={`Page ${i + 1}: ${titles[i] ?? ""}`}
                    >
                        <span class="tab-n">{String(i + 1).padStart(2, "0")}</span>
                        <span class="tab-title t-hand is-sm" aria-hidden="true">
                            {titles[i] ?? ""}
                        </span>
                    </button>
                ))
            }
        </div>
    </div>
</nav>

<!-- ── Page number ────────────────────────────────────────────────────── -->
<div class="page t-hand" id="tc-page" aria-live="polite" data-page="0">
    <span data-page>p. 1</span>
</div>

<!-- ── Close the notebook ─────────────────────────────────────────────── -->
<button class="close t-hand" id="tc-close" type="button" hidden>
    close the notebook
    <svg viewBox="0 0 46 34" width="30" height="22" aria-hidden="true">
        <path
            d="M3 24 C 12 8, 26 6, 41 15"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
        />
        <path
            d="M33 9 L 41 15 L 32 19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
</button>

<style>
    /* ── Tabs ───────────────────────────────────────────────────────── */
    /*
     * Hendri's Index component (Q16): a 48px column on the right edge, a
     * hairline on its page side running full height, fourteen numbers
     * centred and stacked at a 48px pitch, the whole stack centred
     * vertically. The current page is bold; the others sit at half opacity.
     * No caret, no red, no progress line.
     */
    .tabs {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: var(--gutter, 48px);
        z-index: 6;
        color: var(--tc-fg-dim);
    }
    /* The wordmark stays top-left of the page. */
    .tabs-mark {
        position: fixed;
        top: 14px;
        left: 24px;
        white-space: nowrap;
    }
    .tabs-rule {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 1px;
        background: color-mix(in srgb, var(--tc-fg) 30%, transparent);
    }
    .tabs-col {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        transform: translateY(-50%);
    }
    .tabs-cells {
        display: flex;
        flex-direction: column;
    }
    .tab {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 48px; /* 32 visual + the 16 gap, so the hit area is the pitch */
        width: 100%;
        padding: 0;
        font-family: var(--font-type);
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--tc-fg-dim);
        opacity: 0.5;
        transition: opacity 160ms linear;
    }
    .tab[data-state="reading"] {
        font-weight: 700;
        opacity: 1;
    }
    .tab:hover,
    .tab:focus-visible {
        opacity: 1;
    }

    /* The title shows on hover or focus, written beside the number, on the
     * page side. */
    .tab-title {
        position: absolute;
        right: 100%;
        top: 50%;
        margin-right: 10px;
        transform: translateY(-50%) rotate(-2deg);
        white-space: nowrap;
        color: var(--tc-fg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 160ms linear;
    }
    .tab:hover .tab-title,
    .tab:focus-visible .tab-title {
        opacity: 1;
    }

    /* ── Page number ────────────────────────────────────────────────── */
    .page {
        position: fixed;
        left: 20px;
        bottom: 22px;
        z-index: 6;
        pointer-events: none;
        font-family: var(--font-display);
        font-size: 14px;
        letter-spacing: 0.04em;
        color: var(--tc-fg-dim);
    }

    /* ── Close ──────────────────────────────────────────────────────── */
    .close {
        position: fixed;
        right: calc(var(--gutter, 48px) + 36px);
        bottom: 26px;
        z-index: 6;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 4px;
        color: var(--tc-fg);
        transform: rotate(-2deg);
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 4px;
        transition: opacity 240ms linear;
    }
    .close svg {
        transform: rotate(-90deg);
    }
    .close[hidden] {
        display: none;
    }

    /* The tabs are a desktop conceit: on the vertical read there is no pan
     * to index, and their seek buttons duplicate ordinary scrolling. The page
     * number and the close control survive. */
    @media (max-width: 810px) {
        .tabs-col,
        .tabs-rule {
            display: none;
        }
        .tabs {
            bottom: auto;
            width: auto;
        }
        .close {
            right: 20px;
        }
        .tabs-mark {
            padding-top: 16px;
        }
        .page {
            left: 20px;
            bottom: 16px;
        }
        .close {
            right: 20px;
            bottom: 16px;
            /* Finger-sized: the one thing on the vertical read a thumb must hit. */
            padding: 12px 8px;
        }
    }
</style>
