---
/*
 * The tube. Layer order matters and is the whole effect:
 *
 *   trail → static → scanlines → vignette → faceplate
 *
 * The trail sits UNDER the glass, so the tube's falloff and scanlines fall
 * across it too. On top it floats and reads as a browser cursor rather than as
 * something this machine rendered. (Upstream #23.)
 *
 * Scanlines and the vignette are plain CSS, so they survive with JS disabled;
 * only the two canvases need the script.
 */
---

<div class="screenfx" aria-hidden="true">
    <canvas class="fx-layer fx-trail" id="tc-fx-trail"></canvas>
    <canvas class="fx-layer fx-static" id="tc-fx-static"></canvas>
    <div class="fx-layer fx-scanlines"></div>
    <div class="fx-layer fx-vignette"></div>
    <canvas class="fx-layer fx-edge" id="tc-fx-edge"></canvas>
</div>

<style>
    .screenfx {
        position: fixed;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        /*
         * ABOVE everything, including the machine chrome. The whole page is
         * inside the tube, so the readout, rail, log and card all take the
         * vignette, scanlines and static too — chrome that floats above the
         * glass is the one screen in the piece with no screen on it, which is
         * exactly the mistake the boot sequence made upstream (#50).
         *
         * The only thing that may go higher is the boot sequence, which sits
         * just under this and above all other fixed chrome.
         */
        z-index: 10;
    }

    .fx-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .fx-static {
        opacity: 0.05;
        mix-blend-mode: overlay;
        /* Let the browser stretch the small buffer smoothly; the
         * nearest-neighbour alternative reads as big square blocks rather than
         * as grain. */
        image-rendering: auto;
    }

    .fx-scanlines {
        opacity: 0.16;
        background: repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.55) 0px,
            rgba(0, 0, 0, 0.55) 1px,
            transparent 1px,
            transparent 3px
        );
    }

    /*
     * Broad falloff, so the middle of the tube sits slightly proud of the rim
     * even before the grunge starts.
     *
     * The transparent stop was at 54%, which started darkening barely past the
     * centre and was the single biggest reason the edge read as "going in too
     * deep". At 72% it is a rim treatment rather than a tunnel. (Upstream #47.)
     */
    .fx-vignette {
        opacity: 0.24;
        background: radial-gradient(
            150% 130% at 50% 50%,
            transparent 72%,
            var(--void) 100%
        );
    }

    /* The faceplate, stretched from 220×150 — so every boundary in it arrives
     * pre-blurred, for the cost of one draw at mount. */
    .fx-edge {
        opacity: 0.56;
        image-rendering: auto;
    }

    /* The tube is a desktop conceit. On the vertical read it would sit over a
     * scrolling document and read as a dirty overlay rather than as a screen,
     * and the trail is meaningless on touch. */
    @media (max-width: 810px) {
        .screenfx {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        /* The edge stays — it is a static image, not motion. The moving layers
         * go. */
        .fx-trail,
        .fx-static {
            display: none;
        }
    }
</style>
