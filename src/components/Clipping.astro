---
import { Image } from "astro:assets"
import { SOURCES, clippingUrl, type ClippingKey } from "~/content/clippings"

/*
 * One clipping: a photograph pasted onto the page, with its caption written
 * underneath.
 *
 * Descended from memory-lane's `Plate`, and the same line holds (A10):
 * CONTENT stays in the spread file — which picture, where it sits, what was
 * written next to it. What lives here is only the markup identical for every
 * clipping. Moving one is still editing one number in `Spread04.astro`.
 *
 * `id` keeps the `tc-item-NN-N` form because the scroll rig resolves hover
 * against it: the tilt that used to read as a plate under a read head now
 * reads as lifting a photo off the page.
 *
 * `src` is a key into `content/clippings.ts` (a remote placeholder) OR a
 * local import. Remote images need width + height and are cropped to the box
 * with `fit="cover"`; local ones keep their own aspect (DECISIONS Q4).
 */

interface Props {
    /** `NN-N` — spread code and index within it. Becomes the element id. */
    id: string
    src: ClippingKey | ImageMetadata
    /** The caption, in handwriting. Doubles as alt unless `alt` is given. */
    caption: string
    alt?: string
    /** Picture box, in px, inside the 1400px spread. The matte is outside it. */
    x: number
    y: number
    w: number
    h: number
    /** Hand-authored tilt, in degrees. */
    rotate?: number
    /** How it was stuck in. */
    kind?: "photo" | "polaroid" | "scrap"
    /** A strip of masking tape across the top. */
    tape?: boolean
    /**
     * Load immediately rather than lazily. Only the first spreads are on
     * screen at load; the rest sit thousands of pixels to the right.
     */
    eager?: boolean
}

const {
    id,
    src,
    caption,
    alt,
    x,
    y,
    w,
    h,
    rotate,
    kind = "photo",
    tape = false,
    eager = false,
} = Astro.props

const remote = typeof src === "string"
const altText = alt ?? (remote ? SOURCES[src].alt : caption)
const classes = ["clipping", kind === "scrap" ? "torn" : null]
    .filter(Boolean)
    .join(" ")
---

<figure
    class={classes}
    id={`tc-item-${id}`}
    data-kind={kind}
    data-tape={tape ? "" : undefined}
    data-reveal
    data-tc-label={caption}
    data-tc-file={remote ? src : undefined}
    style={`left:${x}px; top:${y}px; width:${w}px; height:${h}px;${
        rotate ? ` transform: rotate(${rotate}deg);` : ""
    }`}
>
    {
        remote ? (
            <Image
                src={clippingUrl(src)}
                alt={altText}
                width={w}
                height={h}
                fit="cover"
                widths={[w, w * 2]}
                sizes={`${w}px`}
                format="avif"
                loading={eager ? "eager" : "lazy"}
                decoding="async"
            />
        ) : (
            <Image
                src={src}
                alt={altText}
                widths={[w, w * 2]}
                sizes={`${w}px`}
                format="avif"
                loading={eager ? "eager" : "lazy"}
                decoding="async"
            />
        )
    }
    <figcaption class="clipping-caption t-hand is-sm">{caption}</figcaption>
</figure>
