---
import { Image } from "astro:assets"

/*
 * One plate: the picture, its registration ticks and its record slug.
 *
 * This is the only shared component in a sector, and it is deliberately thin.
 * DECISIONS A2 keeps CONTENT in the sector files — which plate, where it sits,
 * what the machine observed about it — because free-form editing is the point.
 * What lives here is only the repeated chrome: the <img>, the corner ticks
 * (CSS), and the slug's fixed three fields. Moving a plate still means editing
 * one number in the sector file.
 *
 * `file` is the SOURCE key, not the plate id: sectors 08–11 show the same
 * frames again, and a duplicate must report the same file record as its
 * original or the "bit for bit" copy is a claim the readout contradicts.
 * (Upstream #39.)
 */

interface Props {
    /** `NN-N` — sector code and index within it. Becomes the element id. */
    id: string
    src: ImageMetadata
    /** The machine's own observation. Fills the readout's widest field. */
    label: string
    /**
     * Alt text, when it must differ from the label.
     *
     * The duplicate plates in sectors 08–10 are labelled "duplicate of 01·01",
     * which is the right thing for the readout — it is the machine noticing the
     * card holds the same frame twice — and useless to a screen reader, which
     * gets no description of the picture at all. Those plates pass the
     * original's description here.
     */
    alt?: string
    fmt?: string
    /** Source key, shared by duplicates. */
    file: string
    x: number
    y: number
    w: number
    h: number
    /** Hand-authored tilt, in degrees. */
    rotate?: number
    /** Sector 04 only: stays dithered inside the clean band and never hands its
     *  picture back on hover. */
    corrupt?: boolean
    /**
     * Load immediately rather than lazily.
     *
     * Only the first sectors are on screen at load; the rest of the strip sits
     * thousands of pixels to the right and native lazy loading defers it, which
     * is most of the difference between a 3.8MB first load and a small one.
     * `EffectLayer` already re-measures and uploads on the document's `load`
     * events, so a late arrival still gets its plane.
     */
    eager?: boolean
}

const {
    id,
    src,
    label,
    alt,
    fmt = "RAW",
    file,
    x,
    y,
    w,
    h,
    rotate,
    corrupt = false,
    eager = false,
} = Astro.props

const [code, n] = id.split("-")
---

<div
    class="plate"
    id={`tc-item-${id}`}
    data-tc-label={label}
    data-tc-fmt={fmt}
    data-tc-file={file}
    data-tc-corrupt={corrupt ? "" : undefined}
    style={`left:${x}px; top:${y}px; width:${w}px; height:${h}px;${
        rotate ? ` transform: rotate(${rotate}deg);` : ""
    }`}
>
    <Image
        src={src}
        alt={alt ?? label}
        widths={[w, w * 2]}
        sizes={`${w}px`}
        format="avif"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
    />
    <div class="plate-slug">
        <b>{`${code}·${String(n).padStart(2, "0")}`}</b>
        <span>{fmt}</span>
        <span>{`${w}×${h}`}</span>
    </div>
</div>
