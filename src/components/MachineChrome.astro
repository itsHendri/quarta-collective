---
import { DEFAULT_LINES } from "~/lib/chrome"

interface Props {
    sectors?: number
}
const { sectors = 12 } = Astro.props

/*
 * The machine chrome, in the positions the original settled on:
 *
 *   rail     fixed top, full width, 44px       (Hendri moved it here and kept it)
 *   readout  fixed bottom, full width          (docked, so it never covers a plate)
 *   log      fixed bottom-right, 380px         (clears the audio control at 104px)
 *   card     fixed bottom-left, 152×178
 *
 * All at z-index 6–7, i.e. UNDER the tube at 10 — the chrome is inside the
 * machine and takes the vignette and scanlines like everything else.
 *
 * `[[WORD]]` in a log line renders as an inverted mark, the way the old block
 * marked UNREAD.
 */
const renderLine = (text: string) =>
    text
        .split(/(\[\[[^\]]+\]\])/)
        .map((part) => {
            const m = part.match(/^\[\[([^\]]+)\]\]$/)
            return m ? `<mark>${m[1]}</mark>` : part
        })
        .join("")
---

<!-- ── Sector map ─────────────────────────────────────────────────────── -->
<div class="rail" id="tc-rail" role="navigation" aria-label="Sector map">
    <div class="rail-scanlines" aria-hidden="true"></div>

    <span class="rail-key">recovery rig 04</span>

    <span class="rail-key">
        sector <span class="rail-value" data-rail-sector>00</span>
    </span>

    <div class="rail-map">
        <div class="rail-cells" data-rail-cells>
            {
                Array.from({ length: sectors }, (_, i) => (
                    <button
                        type="button"
                        class="rail-cell"
                        data-cell={i}
                        data-state="unread"
                        aria-label={`Sector ${String(i).padStart(2, "0")}`}
                        title={`Sector ${String(i).padStart(2, "0")}`}
                    />
                ))
            }
        </div>
        <div class="rail-cells rail-fill" data-rail-fill aria-hidden="true">
            {
                Array.from({ length: sectors }, () => (
                    <i class="rail-cell" data-state="read" />
                ))
            }
        </div>
        <div class="rail-head" data-rail-head aria-hidden="true"></div>
    </div>

    <span class="rail-value rail-pct" data-rail-pct>000%</span>
    <span class="rail-key">
        <span class="rail-value" data-rail-state>idle</span>
        <i class="rail-caret" aria-hidden="true"></i>
    </span>
    <span class="rail-key rail-packet">PKT-1987-113</span>
</div>

<!-- ── File readout ───────────────────────────────────────────────────── -->
<div class="readout" id="tc-readout" aria-live="polite">
    <!-- A hairline that never leaves. Without it the readout pops into empty
         space; with it the dock is visibly part of the machine and only its
         contents change. -->
    <div class="readout-rule" aria-hidden="true"></div>
    <div class="readout-row">
        <div class="readout-idle" data-readout-idle>
            <i class="dot" aria-hidden="true"></i>
            <span>head clear · no artifact under aperture</span>
        </div>
        <div class="readout-fields" data-readout-fields>
            <i class="dot is-bright" aria-hidden="true"></i>
            <span class="is-bright" data-readout-name></span>
            <span data-readout-size></span>
            <span class="readout-hair" aria-hidden="true"></span>
            <span class="is-bright readout-label" data-readout-label></span>
            <span class="readout-hair" aria-hidden="true"></span>
            <span data-readout-addr></span>
            <span data-readout-crc></span>
        </div>
    </div>
</div>

<!-- ── Recovery log ───────────────────────────────────────────────────── -->
<div class="log" id="tc-log" aria-live="polite">
    <div><b>RIG 04 — RECOVERY LOG</b> ————— //</div>
    {
        DEFAULT_LINES.map((l, i) => (
            <div
                data-log-line
                style={i === 0 ? "display:block" : "display:none"}
                set:html={renderLine(l.text)}
            />
        ))
    }
</div>

<!-- ── Audio control ──────────────────────────────────────────────────── -->
<!--
  A labelled CONTROL, not a readout field. It began as `aud 1` at 45% opacity
  in the rig's own register, which read as one more instrument field — the
  fiction being served at the expense of the interface. The fiction survives in
  the mono type and the hairline frame; only the affordance changed.
  (Upstream #52.)
-->
<button class="audio" id="tc-audio" type="button" aria-pressed="true" aria-label="Audio on — turn off">
    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path d="M3 10V7a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <rect x="1.5" y="9.5" width="3" height="5" rx="1" fill="currentColor"/>
        <rect x="11.5" y="9.5" width="3" height="5" rx="1" fill="currentColor"/>
        <line class="audio-slash" x1="2" y1="14" x2="14" y2="2" stroke="currentColor" stroke-width="1.3"/>
    </svg>
    <span data-audio-label>Audio on</span>
</button>

<!-- ── The card in the bay ────────────────────────────────────────────── -->
<div class="bay" id="tc-card" role="img" aria-label="Memory card, turning"></div>

<style>
    /* ── Rail ───────────────────────────────────────────────────────── */
    .rail {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 44px;
        z-index: 6;
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 0 24px;
        color: var(--tc-fg);
        overflow: hidden;
    }

    /* Scanlines belong to the machine only — never to a plate. (Upstream #15.) */
    .rail-scanlines {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.22) 0 1px,
            transparent 1px 3px
        );
    }

    /* Labels are tracked; values are NOT — tracking a monospace value destroys
     * the fixed character cell that makes it read as an instrument. (#16.) */
    .rail-key {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--tc-fg-dim);
    }
    .rail-value {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--tc-fg);
        margin-left: 6px;
    }
    .rail-pct {
        min-width: 4ch;
        text-align: right;
        margin-left: 0;
    }
    .rail-packet {
        margin-left: auto;
    }

    .rail-caret {
        display: inline-block;
        width: 7px;
        height: 12px;
        margin-left: 6px;
        vertical-align: -2px;
        background: var(--tc-fg);
        /* Blinks only at rest; the rail sets this variable. */
        animation: var(--tc-blink, tc-blink 1.06s steps(1) infinite);
    }
    @keyframes tc-blink {
        0%,
        50% {
            opacity: 1;
        }
        50.01%,
        100% {
            opacity: 0;
        }
    }

    .rail-map {
        position: relative;
        flex: 1;
        min-width: 120px;
        height: 9px;
    }
    .rail-cells {
        position: absolute;
        inset: 0;
        display: flex;
        gap: 3px;
        color: var(--tc-fg-dim);
    }
    .rail-fill {
        color: var(--tc-fg);
        pointer-events: none;
        clip-path: inset(0 100% 0 0);
    }
    .rail-fill .rail-cell {
        opacity: 1;
        background: currentColor;
    }
    .rail-cell {
        flex: 1;
        height: 9px;
        padding: 0;
        border: none;
        border-radius: 0;
        outline-offset: 2px;
        color: inherit;
        cursor: pointer;
    }
    /* Three states, so a machine that reports in blocks is not drawing a
     * gradient. (Upstream #16.) */
    .rail-cell[data-state="read"] {
        background: currentColor;
        opacity: 0.34;
    }
    .rail-cell[data-state="reading"] {
        background: repeating-linear-gradient(
            45deg,
            currentColor 0 2px,
            transparent 2px 4px
        );
        opacity: 0.55;
    }
    .rail-cell[data-state="unread"] {
        background: repeating-linear-gradient(
            45deg,
            currentColor 0 1px,
            transparent 1px 5px
        );
        opacity: 0.3;
    }

    /* The head. A 1px line moving continuously is what makes the bar trackable
     * between block boundaries. (Upstream #30.) */
    .rail-head {
        position: absolute;
        top: -5px;
        bottom: -5px;
        left: 0;
        width: 1px;
        background: var(--tc-fg);
        pointer-events: none;
    }

    /* ── Readout ────────────────────────────────────────────────────── */
    .readout {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 6;
        pointer-events: none;
        padding: 0 24px 10px;
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        line-height: 1.6;
        letter-spacing: 0.06em;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        text-transform: uppercase;
        color: var(--tc-fg-dim);
    }
    .readout-rule {
        height: 1px;
        background: var(--tc-fg-dim);
        opacity: 0.28;
        margin-bottom: 6px;
    }
    .readout-row {
        position: relative;
        min-height: 22px;
    }
    .readout-idle,
    .readout-fields {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: opacity 140ms linear;
    }
    .readout-idle {
        gap: 10px;
        opacity: 0.7;
    }
    .readout-fields {
        opacity: 0;
    }
    .readout-label {
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .readout-hair {
        flex: 1;
        min-width: 12px;
        height: 1px;
        background: var(--tc-fg-dim);
        opacity: 0.35;
    }
    .dot {
        width: 5px;
        height: 5px;
        flex: none;
        background: currentColor;
        opacity: 0.6;
    }
    .is-bright {
        color: var(--tc-fg);
        opacity: 1;
    }
    /* The ONE surviving use of Alert. It sits on the machine's own dock and
     * never travels under the tint, so it cannot fall to 1.4:1 the way it did
     * on the strip. (Upstream #35.) */
    [data-readout-crc].is-bad {
        color: var(--alert);
    }

    /* ── Log ────────────────────────────────────────────────────────── */
    .log {
        position: fixed;
        right: 24px;
        bottom: 104px;
        z-index: 6;
        width: 380px;
        padding: 12px 14px;
        font-family: var(--font-mono);
        font-size: 9.5px;
        font-weight: 400;
        line-height: 1.85;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: justify;
        color: var(--tc-fg-dim);
    }
    .log b {
        font-weight: 500;
        color: var(--tc-fg);
    }
    .log [data-log-line] {
        transition: color 900ms linear;
    }
    /* The newest line lands bright, then settles to dim. */
    .log [data-log-line].is-new {
        color: var(--tc-fg);
        transition: none;
    }
    .log mark {
        background: var(--tc-fg);
        color: var(--tc-field);
        padding: 0 3px;
    }

    /* ── Audio ──────────────────────────────────────────────────────── */
    .audio {
        position: fixed;
        right: 24px;
        bottom: 60px;
        z-index: 6;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border: 1px solid var(--rule);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--tc-fg);
        transition: opacity 160ms linear, background-color 160ms linear;
    }
    .audio:hover {
        background: color-mix(in srgb, var(--tc-fg) 12%, transparent);
    }
    /* The slash only shows when muted — a control must read as off at a glance. */
    .audio[data-on="1"] .audio-slash {
        display: none;
    }

    /* ── Bay ────────────────────────────────────────────────────────── */
    .bay {
        position: fixed;
        left: 0;
        bottom: 0;
        z-index: 7;
        width: 152px;
        height: 178px;
        display: grid;
        place-items: center;
        pointer-events: none;
        /* Perspective belongs on the PARENT — an element's own perspective
         * applies to its children, not to itself. (Upstream #31.) */
        perspective: 720px;
    }

    /* The chrome is a desktop conceit: on the vertical read there is no pan to
     * report, the rail's seek buttons duplicate ordinary scrolling, and a
     * 380px log does not fit a 390px viewport. The log and readout survive;
     * the rail and the bay do not. */
    @media (max-width: 810px) {
        .rail,
        .bay {
            display: none;
        }
        .audio {
            bottom: 20px;
            /*
             * The control measured 101×26 on a phone — the only thing on the
             * vertical read a finger has to hit, and under the 44px target.
             * Padding rather than a height, so the bordered chip keeps its
             * proportions and only the hit area grows.
             */
            padding: 14px 10px;
        }
        .log {
            position: static;
            width: auto;
            margin: 40px 20px;
        }
        .readout {
            display: none;
        }
    }
</style>
