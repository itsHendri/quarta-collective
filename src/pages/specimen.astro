---
import Base from "~/layouts/Base.astro"
import { RAMP, RAMP_HEX, tint } from "~/lib/contrast"

/*
 * Type specimen — the permanent dev surface for the type system. Every
 * preset on every stop of the paper ramp, with the derived ink and dim tone
 * computed by the same `tint()` the rig runs, so what is seen here is what
 * the page gets. Not linked from the piece.
 */
const stops = RAMP_HEX.map((hex, i) => ({
    hex,
    ...tint(RAMP, i / (RAMP_HEX.length - 1)),
}))
---

<Base title="Quarta Collective — specimen" description="Type specimen.">
    {
        stops.map((s) => (
            <section
                class="stop"
                style={`--tc-bg:${s.bg}; --tc-fg:${s.fg}; --tc-fg-dim:${s.dim}; --tc-field:${s.bg};`}
            >
                <p class="t-eyebrow">
                    stop {s.hex} · L {s.lum.toFixed(3)} · dim {s.dim}
                </p>
                <h2 class="t-display">
                    The art of <em>making</em>
                </h2>
                <p class="t-body">
                    Same table, same night. Phones in a bowl by the door.
                    Whoever arrives first puts the kettle on.
                </p>
                <p class="t-hand is-lg">a notebook. obviously.</p>
                <p class="t-hand">120gsm — too thin. 160 — just right.</p>
                <p class="t-hand is-sm">wk 6, the one that opens flat</p>
                <p class="t-label">Index · p. 04</p>
                <p class="t-value">2026-10-05 · 48 pp · 160 gsm</p>
                <p>
                    <span class="t-inverted t-label">parked</span>
                </p>
            </section>
        ))
    }
</Base>

<style>
    .stop {
        background: var(--tc-bg);
        padding: 56px 72px;
        display: grid;
        gap: 18px;
    }
    .t-display {
        text-wrap: balance;
    }
</style>
