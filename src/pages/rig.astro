---
import Base from "~/layouts/Base.astro"
import "~/styles/stage.css"

/*
 * Rig test surface — a permanent dev page, not part of the piece.
 *
 * Twelve numbered blocks in place of real sectors, so the mechanism can be
 * judged on its own: does the strip pan, does the tint ramp run, does the
 * derived foreground stay legible, does hover tilt a plate, does the mobile
 * fallback still publish progress.
 *
 * Deliberately ugly. If this page ever starts looking designed, the real
 * sectors are being built in the wrong file.
 */

const SECTORS = 12
const sectors = Array.from({ length: SECTORS }, (_, i) => i)
---

<Base title="SECTOR READ — rig test">
    <div class="tc-track" id="tc-track" style={`--tc-sectors:${SECTORS}`}>
        <div class="tc-stage" id="tc-stage">
            <div class="tc-strip" id="tc-strip">
                {
                    sectors.map((i) => (
                        <section
                            class="tc-sector"
                            id={`tc-sector-${String(i).padStart(2, "0")}`}
                            aria-label={`Sector ${String(i).padStart(2, "0")}`}
                        >
                            <p class="t-eyebrow">
                                sector {String(i).padStart(2, "0")}
                            </p>
                            <p class="num t-display">
                                {String(i).padStart(2, "0")}
                            </p>
                            <div
                                class="plate"
                                id={`tc-item-${String(i).padStart(2, "0")}-0`}
                                data-tc-label={`test plate ${i}`}
                                data-tc-fmt="JPG"
                                data-tc-file={`plate-${i}`}
                            >
                                <p class="t-value">hover me</p>
                            </div>
                        </section>
                    ))
                }
            </div>

            <div class="hud">
                <p class="t-value" id="hud-p">p 0.00000</p>
                <p class="t-value" id="hud-pan">pan 0</p>
                <p class="t-value" id="hud-bg">bg —</p>
                <p class="t-value" id="hud-hover">hover —</p>
            </div>
        </div>
    </div>
</Base>

<script>
    import { initScrollRig } from "~/lib/scroll-rig"

    initScrollRig()

    // Mirror the bus into the HUD, which is also the cheapest proof that a
    // subscriber sees what the rig publishes.
    const el = (id: string) => document.getElementById(id)!
    addEventListener("tc:scroll", (e) => {
        const d = e.detail
        el("hud-p").textContent = `p ${d.p.toFixed(5)}`
        el("hud-pan").textContent = `pan ${Math.round(d.panX)}`
        el("hud-bg").textContent = `bg ${getComputedStyle(
            document.documentElement
        ).getPropertyValue("--tc-bg")}`
    })
    addEventListener("tc:hover", (e) => {
        el("hud-hover").textContent = `hover ${e.detail.label ?? "—"}`
    })
</script>

<style>
    .tc-sector {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 0 60px;
        border-right: 1px solid var(--rule);
    }
    .num {
        opacity: 0.22;
    }
    .plate {
        width: 260px;
        height: 170px;
        display: grid;
        place-items: center;
        background: color-mix(in srgb, var(--tc-fg) 12%, transparent);
        border: 1px solid var(--rule);
    }
    .hud {
        position: fixed;
        left: 16px;
        bottom: 16px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        pointer-events: none;
        z-index: 20;
    }
</style>
