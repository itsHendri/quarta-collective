---
import Base from "~/layouts/Base.astro"
import Spread00 from "~/spreads/Spread00.astro"
import Spread01 from "~/spreads/Spread01.astro"
import Spread02 from "~/spreads/Spread02.astro"
import Spread03 from "~/spreads/Spread03.astro"
import Spread04 from "~/spreads/Spread04.astro"
import Spread05 from "~/spreads/Spread05.astro"
import Spread06 from "~/spreads/Spread06.astro"
import Spread07 from "~/spreads/Spread07.astro"
import Spread08 from "~/spreads/Spread08.astro"
import Spread09 from "~/spreads/Spread09.astro"
import Spread10 from "~/spreads/Spread10.astro"
import Spread11 from "~/spreads/Spread11.astro"
import NotebookChrome from "~/components/NotebookChrome.astro"
import { TITLES } from "~/spreads/titles"
import "~/styles/stage.css"
import "~/styles/spread.css"
import "~/styles/paper.css"

/*
 * The notebook.
 *
 * NOTHING MAY COME AFTER THE TRACK — no footer, no colophon section. A section
 * below it keeps scrolling once the read is done and takes the pinned stage
 * off the top of the screen. The colophon lives on the cover for exactly
 * this reason. (memory-lane #36.)
 *
 * `--tc-sectors` drives the track's height (spreads × 100vh), so it must
 * match the number of spreads below — and `TITLES` in spreads/titles.ts.
 */

const SPREADS = TITLES.length
---

<Base>
    <div class="tc-track" id="tc-track" style={`--tc-sectors:${SPREADS}`}>
        <div class="tc-stage" id="tc-stage">
            <div class="tc-strip" id="tc-strip">
                <Spread00 />
                <Spread01 />
                <Spread02 />
                <Spread03 />
                <Spread04 />
                <Spread05 />
                <Spread06 />
                <Spread07 />
                <Spread08 />
                <Spread09 />
                <Spread10 />
                <Spread11 />
            </div>
        </div>
    </div>

    <NotebookChrome sectors={SPREADS} titles={TITLES} />
    {/* The sheet everything is printed on: above the chrome, under nothing. */}
    <div class="grain" aria-hidden="true"></div>
</Base>

<script>
    import { initScrollRig } from "~/lib/scroll-rig"
    import { initReveal } from "~/lib/reveal"
    import {
        initProgressRail,
        initPageCounter,
        initCloseButton,
    } from "~/lib/chrome"

    const byId = (id: string) => document.getElementById(id)
    const spreads = Number(
        getComputedStyle(byId("tc-track")!).getPropertyValue("--tc-sectors")
    ) || 12

    /*
     * Everything here is cheap — there is no WebGL, no boot, no audio — so
     * there is no critical/deferred split any more (memory-lane A20). The
     * rig first, so scroll works from the first frame.
     */
    initScrollRig()
    initReveal()

    const rail = byId("tc-rail")
    if (rail) initProgressRail({ root: rail, sectors: spreads })

    const page = byId("tc-page")
    if (page) initPageCounter({ root: page, sectors: spreads })

    const close = byId("tc-close")
    if (close) initCloseButton({ button: close })
</script>
